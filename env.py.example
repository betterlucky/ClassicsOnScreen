"""
Environment configuration for ClassicsOnScreen.
Copy this file to /etc/classicsonscreen/env.py and update with real values.
All uppercase variables will be loaded as environment variables.
"""

# Django settings
SECRET_KEY = 'your-secret-key-here'
DEBUG = 'False'  # Set to 'True' for development
ALLOWED_HOSTS = 'your-domain.com,www.your-domain.com'

# Database and static files
DJANGO_DB_PATH = '/app/db/db.sqlite3'
STATIC_ROOT = '/app/staticfiles'

# Email settings
EMAIL_HOST_PASSWORD = 'your-email-password'

# API keys
OMDB_API_KEY = 'your-omdb-api-key' 